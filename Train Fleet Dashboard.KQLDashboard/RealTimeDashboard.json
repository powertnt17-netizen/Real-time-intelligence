  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "Tabela_Alertas\r\n| summarize Numero_de_Erros = count() by bin(Datahora_Evento, 1d), Tipo_Alerta, Comboio, Carruagem\r\n| order by Datahora_Evento asc",
      "id": "535dc29e-c3d3-484a-bfeb-9886f9c551b0",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "Tabela_Alertas\r\n// 1. Filtro de tempo ligado ao dashboard\r\n| where todatetime(Datahora_Evento) between (_startTime .. _endTime)\r\n// 2. Filtro dinâmico do comboio\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 3. Mostra todos os erros críticos (Se quiseres mesmo limitar, ajusta esta linha)\r\n// | where Tipo_de_Evento in (\"Door Open\", \"Smoke Detector\", \"Temperature\", \"Humidity\")\r\n// 4. Ordena para veres sempre a emergência mais recente no topo\r\n| order by todatetime(Datahora_Evento) desc\r\n// 5. Opcional: traduzir os cabeçalhos para inglês para manter o padrão profissional do dashboard\r\n| project \r\n    Train = Comboio,\r\n    Carriage = Carruagem,\r\n    Alert_Time = Datahora_Evento,\r\n    Event_Type = Tipo_de_Evento,\r\n    Alert_Description = Tipo_Alerta,\r\n    Value = Valor,\r\n    Latitude,\r\n    Longitude\r\n| take 500",
      "id": "9e62f875-9ece-4cd1-946f-e6dbe5cef867",
      "usedVariables": [
        "_endTime",
        "_startTime",
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "Tabela_Alertas\r\n// 1. Liga ao parâmetro de tempo do Dashboard (Time range)\r\n| where Datahora_Evento between (_startTime .. _endTime)\r\n// 2. Liga ao parâmetro do Comboio (Train Filter) - Sem usar o 'let'!\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 3. A tua métrica\r\n| where Tipo_Alerta contains \"Temperatura\"\r\n| count",
      "id": "8d4bd512-2dc7-4e04-9d5e-2aac212eda5d",
      "usedVariables": [
        "_endTime",
        "_startTime",
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "Tabela_Alertas\r\n// 1. Filtro dinâmico robusto (entende o \"All\" e seleções múltiplas)\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 2. Garantir que as coordenadas são lidas como números e existem\r\n| extend Latitude = todouble(Latitude), Longitude = todouble(Longitude)\r\n| where isnotnull(Latitude) and isnotnull(Longitude)\r\n// 3. Trazer apenas as colunas que interessam para o mapa ficar rápido\r\n| project Datahora_Evento, Tipo_Alerta, Carruagem, Latitude, Longitude",
      "id": "b8cf0850-6ea9-4846-8bbb-1d420e3fbb33",
      "usedVariables": [
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "Tabela_Alertas\r\n// 1. Liga ao parâmetro de tempo do Dashboard (Time range)\r\n| where Datahora_Evento between (_startTime .. _endTime)\r\n// 2. Liga ao parâmetro do Comboio (Train Filter)\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 3. A métrica específica deste cartão\r\n| where Tipo_Alerta contains \"Humidade\"\r\n| count",
      "id": "abf12783-d2ae-4ed0-8692-b8a01ddf46f5",
      "usedVariables": [
        "_endTime",
        "_startTime",
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "Tabela_Desperdicio\r\n| summarize Minutos_Desperdicio = count() * 5 by Comboio, Carruagem\r\n| extend Identificacao = strcat(\"Comboio \", Comboio, \" - Carr. \", Carruagem)\r\n// A magia acontece aqui: escondemos tudo o resto e entregamos só 2 colunas ao gráfico!\r\n| project Identificacao, Minutos_Desperdicio\r\n| order by Minutos_Desperdicio desc",
      "id": "6bbad13f-c478-4e6b-b4e2-1575e711ac74",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "Tabela_Desperdicio\r\n| order by Datahora_Evento desc\r\n| project \r\n    Hora = format_datetime(Datahora_Evento, 'yyyy-MM-dd HH:mm:ss'), \r\n    Comboio, \r\n    Carruagem, \r\n    Alerta = Desperdicio\r\n| take 50",
      "id": "7621f40a-2299-46aa-a4fa-4ab6929cbc5e",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "V2\r\n| where Tipo_de_Evento == \"HVAC Status\"\r\n// Vai buscar apenas a última leitura de cada AC em cada carruagem\r\n| summarize arg_max(Datahora_Evento, Valor) by Comboio, Carruagem\r\n| where todouble(Valor) > 0\r\n| count",
      "id": "3a65df5f-4ca7-4508-aae1-ba64ecc4d6ff",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "V2\r\n// 1. Liga ao parâmetro de tempo do Dashboard (Time range)\r\n| where todatetime(Datahora_Evento) between (_startTime .. _endTime)\r\n// 2. Liga ao parâmetro do Comboio (Train Filter)\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 3. Conta os comboios únicos a transmitir dados\r\n| summarize Frota_Online = dcount(Comboio)",
      "id": "5d80b8d3-c233-4b80-abc6-4251b58d53fb",
      "usedVariables": [
        "_endTime",
        "_startTime",
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "V2\r\n| where isnotnull(Latitude) and isnotnull(Longitude)\r\n// Vai buscar APENAS o último sinal GPS de cada comboio\r\n| summarize arg_max(Datahora_Evento, *) by Comboio\r\n| project \r\n    Comboio = strcat(\"Comboio \", Comboio), \r\n    Latitude = todouble(Latitude), \r\n    Longitude = todouble(Longitude),\r\n    Ultima_Vez_Visto = format_datetime(Datahora_Evento, 'HH:mm:ss')",
      "id": "390da54f-22cc-4c94-8a71-2ed9e8f4d976",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "Tabela_Desperdicio\r\n| summarize Minutos_Totais = count() * 5\r\n// Assume-se ~0.5 kWh por minuto de AC e ~0.25 kg de CO2 por kWh (média europeia)\r\n| extend Energia_Desperdicada_kWh = Minutos_Totais * 0.5\r\n| extend Pegada_CO2_kg = Energia_Desperdicada_kWh * 0.25\r\n| project Pegada_CO2_kg",
      "id": "9ed480aa-2083-48c7-a14f-86e303923309",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "tabela_variaveis_lentas_filtrada\r\n| where Tipo_de_Evento == \"Temperature\"\r\n// 1. Respeita o parâmetro de tempo do topo da página\r\n| where todatetime(Datahora_Evento) between (_startTime .. _endTime)\r\n// 2. Respeita o parâmetro do comboio\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 3. A tua lógica original (que está excelente para formatar o texto!)\r\n| summarize Temp_Maxima = max(todouble(Valor)) by Comboio, Carruagem\r\n| top 1 by Temp_Maxima\r\n| project Alerta = strcat(\"Value: \", Temp_Maxima, \"ºC (Train. \", Comboio, \")\")",
      "id": "3069c823-8e3f-43d6-989b-8a9ab32c63a9",
      "usedVariables": [
        "_endTime",
        "_startTime",
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "tabela_variaveis_lentas_filtrada\r\n| where Tipo_de_Evento in (\"Temperature\", \"Humidity\")\r\n// Garantir que os valores são tratados como números decimais\r\n| extend Valor_Numerico = todouble(Valor)\r\n// Fazer a média de 15 em 15 minutos por cada tipo de sensor\r\n| summarize Media_Valor = avg(Valor_Numerico) by Tipo_de_Evento, JanelaTempo = bin(todatetime(Datahora_Evento), 15m)\r\n| order by JanelaTempo asc",
      "id": "46fdafe5-b78f-49da-b53c-4668a8f13f22",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "tabela_variaveis_lentas_filtrada\r\n| where Tipo_de_Evento == \"Humidity\"\r\n// 1. Respeita o parâmetro de tempo do topo da página (Time range)\r\n| where todatetime(Datahora_Evento) between (_startTime .. _endTime)\r\n// 2. Respeita o parâmetro do comboio (Train Filter)\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 3. A tua lógica para encontrar o valor máximo\r\n| summarize Max_Humidade = max(todouble(Valor)) by Comboio, Carruagem\r\n| top 1 by Max_Humidade\r\n| project Alerta = strcat(\"Value: \", Max_Humidade, \"% (Train. \", Comboio, \")\")",
      "id": "a3e3a28a-acb8-4840-a0f3-ab640ee24b9d",
