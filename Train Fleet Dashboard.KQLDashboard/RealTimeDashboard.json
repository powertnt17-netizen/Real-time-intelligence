      },
      "text": "tabela_variaveis_lentas_filtrada\r\n| where Tipo_de_Evento == \"Humidity\"\r\n| where todatetime(Datahora_Evento) > ago(24h)\r\n| summarize Min_Humidade = min(todouble(Valor)) by Comboio, Carruagem\r\n| top 1 by Min_Humidade asc\r\n| project Alerta = strcat(\"Min: \", Min_Humidade, \"% (Train \", Comboio, \")\")",
      "id": "63413e71-996e-42f3-97ac-53168633f5d4",
