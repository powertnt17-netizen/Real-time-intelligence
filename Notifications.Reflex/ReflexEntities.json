    "payload": {
      "name": "Raw_Data_datalive event",
      "runSettings": {
        "executionIntervalInSeconds": 60
      },
      "query": {
        "queryString": "V2\n// 1. FILTRO DE PERFORMANCE: Ler últimos 2 minutos e apenas as variáveis necessárias\n| where todatetime(Datahora_Evento) >= ago(2m)\n| where Tipo_de_Evento in (\"Speed\", \"Brake Pressure\")\n// 2. AGRUPAMENTO AO SEGUNDO: Cruzar a leitura exata (Sem ID_Equipamento!)\n| summarize \n    Velocidade = maxif(todouble(Valor), Tipo_de_Evento == \"Speed\"), \n    Pressao_Travoes = maxif(todouble(Valor), Tipo_de_Evento == \"Brake Pressure\") \n    by Comboio, Carruagem, SegundoExato = bin(todatetime(Datahora_Evento), 1s)\n// 3. CONDIÇÃO CRÍTICA: Andar rápido com os travões a fundo\n| where Velocidade > 20 and Pressao_Travoes > 3.5\n// 4. AGRUPAMENTO AO MINUTO: A barreira Anti-Spam para o Data Activator\n| summarize\n    MaxVelocidade = max(Velocidade),\n    MaxPressao = max(Pressao_Travoes),\n    Segundos_em_Falha_Neste_Minuto = count()\n    by Comboio, Carruagem, TimeWindow = bin(SegundoExato, 1m)"
