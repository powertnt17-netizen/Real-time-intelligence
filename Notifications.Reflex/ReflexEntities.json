    "payload": {
      "name": "Raw_Data_datalive event",
      "runSettings": {
        "executionIntervalInSeconds": 60
      },
      "query": {
        "queryString": "V2\r\n// 1. FILTRO DE PERFORMANCE: Ler os últimos 2 minutos\r\n| where todatetime(Datahora_Evento) >= ago(2m)\r\n| where Tipo_de_Evento in (\"Door Open\", \"Speed\")\r\n// 2. AGRUPAMENTO AO SEGUNDO: Resolve o problema dos milissegundos (substitui o join)\r\n| summarize \r\n    Estado_Porta = maxif(toint(Valor), Tipo_de_Evento == \"Door Open\"),\r\n    Velocidade = maxif(todouble(Valor), Tipo_de_Evento == \"Speed\")\r\n    by Comboio, Carruagem, SegundoExato = bin(todatetime(Datahora_Evento), 1s)\r\n// 3. CONDIÇÃO CRÍTICA: Porta aberta (1) a mais de 10 km/h\r\n| where Estado_Porta == 1 and Velocidade > 10\r\n// 4. AGRUPAMENTO AO MINUTO: A barreira Anti-Spam para o Data Activator\r\n| summarize \r\n    MaxVelocidade = max(Velocidade),\r\n    Segundos_em_Perigo_Neste_Minuto = count()\r\n    by Comboio, Carruagem, TimeWindow = bin(SegundoExato, 1m)"
      },
