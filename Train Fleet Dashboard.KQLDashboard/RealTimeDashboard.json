    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "tabela_variaveis_lentas_filtrada\r\n| where Tipo_de_Evento == \"Temperature\"\r\n// 1. Filtros de Tempo e Comboio\r\n| where todatetime(Datahora_Evento) between (_startTime .. _endTime)\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 2. Agrupar a cada 1 minuto para veres as linhas a formar-se rapidamente\r\n| summarize Media_Temperatura = round(avg(todouble(Valor)), 1) \r\n    by Intervalo_1Min = bin(todatetime(Datahora_Evento), 1m), Comboio\r\n// 3. Ordenar no tempo para o gráfico desenhar da esquerda para a direita\r\n| order by Intervalo_1Min asc",
      "id": "8834edb3-58bc-41e6-81f6-baf13ee2894c",
      "usedVariables": [
        "_endTime",
        "_startTime",
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "V2\r\n| where Tipo_de_Evento == \"Speed\"\r\n// 1. Filtros globais de tempo e comboio\r\n| where todatetime(Datahora_Evento) between (_startTime .. _endTime)\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 2. Considera apenas comboios em movimento (ajusta o limite se necessário)\r\n| where todouble(Valor) > 5\r\n// 3. Calcula a média global da velocidade\r\n| summarize Velocidade_Media = round(avg(todouble(Valor)), 1)",
      "id": "8bd7a189-da1e-41cc-9c57-72d5c938e2cd",
      "usedVariables": [
        "_endTime",
        "_startTime",
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "V2\r\n| where Tipo_de_Evento == \"Speed\"\r\n| where todatetime(Datahora_Evento) between (_startTime .. _endTime)\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n| extend Velocidade = round(todouble(Valor), 2)\r\n// 1. Filtra infrações acima do limite (120 km/h)\r\n| where Velocidade > 120\r\n// 2. arg_max: Encontra a velocidade máxima e traz o contexto exato desse segundo\r\n| summarize arg_max(Velocidade, Datahora_Evento, Latitude, Longitude, Carruagem) by Comboio\r\n// 3. Ordena os infratores do mais rápido para o mais lento\r\n| order by Velocidade desc\r\n// 4. Limita aos 5 piores casos\r\n| take 5\r\n// 5. Project: Traduz e organiza os nomes das colunas para o Dashboard final\r\n| project \r\n    Train = Comboio, \r\n    Carriage = Carruagem, \r\n    Max_Speed_kmh = Velocidade, \r\n    Infraction_Time = Datahora_Evento, \r\n    Latitude, \r\n    Longitude",
      "id": "b148e3a2-750c-423b-a809-a4c951ff8efa",
      "usedVariables": [
        "_endTime",
        "_startTime",
        "p_comboio"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2685d6ea-8914-4061-8593-8f8e9f1644ac"
      },
      "text": "V2\r\n// 1. Filtra as duas variáveis cinemáticas em simultâneo\r\n| where Tipo_de_Evento in (\"Speed\", \"Brake Pressure\")\r\n| where todatetime(Datahora_Evento) between (_startTime .. _endTime)\r\n| where p_comboio == \"All\" or p_comboio == \"*\" or p_comboio == \"\" or tostring(Comboio) in (p_comboio)\r\n// 2. Isola as métricas em colunas separadas agrupando por minuto e comboio\r\n| summarize\r\n    Velocidade = round(avgif(todouble(Valor), Tipo_de_Evento == \"Speed\"), 1),\r\n    Pressao_Travao = round(avgif(todouble(Valor), Tipo_de_Evento == \"Brake Pressure\"), 1)\r\n    by Intervalo_1Min = bin(todatetime(Datahora_Evento), 1m), Comboio\r\n| order by Intervalo_1Min asc",
      "id": "05a95f98-d592-4a87-ae23-9f456345494b",
      "usedVariables": [
